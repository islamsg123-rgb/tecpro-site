# Copie para .env.local e preencha quando a Escola Avançada liberar.
# Enquanto ESCOLA_AVANCADA_TOKEN estiver vazio, o site usa dados de exemplo (src/lib/escola-avancada/mock.ts).

# Endereço da escola na plataforma (ex.: https://suaescola.com). Pedir ao suporte.
ESCOLA_AVANCADA_URL=
# Token gerado em Configurações > GERAR TOKEN na plataforma.
ESCOLA_AVANCADA_TOKEN=

# ---- Asaas (pagamentos) ----
# Sem ASAAS_API_KEY o site usa o SIMULADOR de pagamento (nada é cobrado).
# Chave: painel do Asaas > Integrações > Chave de API. Use primeiro a do sandbox (conta de testes).
ASAAS_API_KEY=
# "sandbox" (testes) ou "producao" (cobranças reais)
ASAAS_AMBIENTE=sandbox
# Senha que você inventa e cadastra também no webhook do Asaas (Integrações > Webhooks)
ASAAS_WEBHOOK_TOKEN=

# ---- Supabase (login e banco da área do aluno) ----
# Sem estas variáveis, a área do aluno roda em MODO DEMONSTRAÇÃO (entra com qualquer e-mail).
# Painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor, nunca expor.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do site, usado no link de login enviado por e-mail.
NEXT_PUBLIC_SITE_URL=
